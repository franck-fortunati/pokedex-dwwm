<!DOCTYPE html>
    <html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/css/style.css">
        <title><%= title %> | Pocket Fetcher</title>
    </head>
    <body class="bg-light d-flex flex-column min-vh-100">
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark fixed-top bg-perso p-3">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold" href="/">
                        <span class="brandBall"></span>
                        <span>Pocket <span class="text-warning">Fetcher</span></span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                            <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                        <div class="navbar-nav fw-semibold">
                            <a class="nav-link text-link active" href="/">Accueil</a>
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-link" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Générations
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <% for (let i = 1; i <= 9; i++) { %>
                                        <li>
                                            <a class="dropdown-item" href="/generation/<%= i %>">Génération <%= i %></a>
                                        </li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <main class="container pt-5 mt-4 flex-grow-1">
            <%- include(page) %>
        </main>
        <footer class="bg-perso-footer text-white text-center py-3 mt-auto">
            <div class="container">
                <p class="mb-1">Fait avec curiosité et <a href="https://pokeapi.co/" target="_blank" class="text-warning text-decoration-none">PokéAPI</a>.</p>
                <small class="text-white">Projet réalisé par Franck</small>
            </div>
        </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>