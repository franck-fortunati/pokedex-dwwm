<section class="pokelist">
    <h1 class="display-4 text-center my-2 pt-5 fw-semibold"> Tous les Pokémon, <br> <span class="text-warning">à porté de clic !</span></h1>
    <p class="text-secondary text-center lead pb-5">Parcours le Pokédex, découvre leurs types et trouve ton prochain favori.</p>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-4">
        <% pokemons.forEach(pokemon => { %>
            <div class="col">
                <div class="card cardPokemon h-100 shadow-sm text-center">
                    <img src="<%= pokemon.image %>" alt="<%= pokemon.name %>" class="card-img-top p-3 bg-light">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <h5 class="card-title text-capitalize fw-bold">
                            #<%= pokemon.id %> <%= pokemon.name %>
                        </h5>
                        <a href="/pokemon/<%= pokemon.name %>" class="btn btn-outline-red btn-sm mt-2">
                            Voir la fiche
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
    <div class="d-flex justify-content-center align-items-center my-5">
        <% 
            let baseUrl = '/?page=';

            if (typeof genId !== 'undefined' && genId) {
                baseUrl = '/generation/' + genId + '?page=';
            }
        %>

        <% if (currentPage > 1) { %>
            <a href="<%= baseUrl %><%= currentPage - 1 %>" class="btn btn-red">Page précédente</a>
        <% } else { %>
            <div></div>
        <% } %>

        <span class="fw-bold mx-5"><%= currentPage %></span>

        <% if (typeof totalPages !== 'undefined' ? currentPage < totalPages : true) { %>
            <a href="<%= baseUrl %><%= currentPage + 1 %>" class="btn btn-red">Page suivante</a>
        <% } %>
    </div>
</section>